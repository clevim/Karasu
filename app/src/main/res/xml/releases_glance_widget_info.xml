<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is what rolls the widget over at midnight: "today" stops being today
    without anything in the app happening, so the widget has to be the one to notice.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/appwidget_releases_description"
    android:previewImage="@drawable/updates_grid_widget_preview"
    android:initialLayout="@layout/appwidget_loading"
    android:minWidth="240dp"
    android:minHeight="110dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="3600000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
