-- What MangaBaka and the trackers found about a library entry (ids elsewhere, other names, tags,
-- status), as JSON. It lived in one preference keyed by manga id: the whole map rewritten on every
-- change, loaded into memory at start-up, and pointing at the wrong entries after a restore onto a
-- fresh install, where every manga gets a new id. Here it cascades with its manga and travels in
-- the backup with it.
CREATE TABLE manga_extras(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    data TEXT NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);
